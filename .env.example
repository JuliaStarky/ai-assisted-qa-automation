# Run tests
# Required to clone and run Playwright. Copy this file to .env and replace the placeholders.
# playwright.config.ts loads .env. Do not commit .env. Never put real secrets in this file.

# Didaxis environment the suite opens. No path after the host.
DIDAXIS_URL=https://test.didaxis.studio

# Admin account. tests/auth.setup.ts signs in with it and writes playwright/.auth/user.json.
DIDAXIS_EMAIL=admin@example.com

# Password for DIDAXIS_EMAIL.
DIDAXIS_PASSWORD=replace-with-password

# Bearer token for DELETE /api/programs. Tests that create a program call trackProgram(uuid).
DIDAXIS_API_TOKEN=replace-with-api-token

# Optional. Second account for permission probes. The default suite does not read it.
DIDAXIS_ALT_EMAIL=viewer@example.com

# Optional. Password for DIDAXIS_ALT_EMAIL.
DIDAXIS_ALT_PASSWORD=replace-with-alt-password

# Agent / CI setup
# Not needed for `npx playwright test` alone.
# Headless agent: .github/workflows/test-generation.yml
# In the IDE, put Atlassian MCP tokens in Cursor settings instead of this file.

# API key for the headless `agent` CLI (agent -p) in test-generation.yml.
CURSOR_API_KEY=replace-with-cursor-api-key

# Atlassian API token for that headless agent and for the Atlassian MCP server.
ATLASSIAN_API_TOKEN=replace-with-atlassian-api-token

# Atlassian site origin (https://your-site.atlassian.net). The workflow secret name is ATLASSIAN_SITE_URL.
ATLASSIAN_BASE_URL=https://your-site.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN.
ATLASSIAN_EMAIL=you@example.com
